DATABASE_URI=postgresql+asyncpg://<user>:<password>@localhost:5432/seat_reservation

# User tokens (HS256). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Token lifetime in seconds (default 1800 = 30 minutes)
TOKEN_TTL_SECONDS=1800

# Admin key for POST /shows, sent as the X-Admin-Key header.
# Generate: python3 -c "import uuid; print(uuid.uuid4())"
ADMIN_API_KEY=

# Optional
# DEFAULT_PER_USER_LIMIT=4
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
